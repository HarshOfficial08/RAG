JWT_SECRET=replace-with-a-random-32-byte-secret-for-any-real-deployment
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Get a key at ollama.com/settings/keys. Not every :cloud model is available
# on every plan — larger models (qwen3.5:cloud, etc.) can 403 with "requires a
# subscription" on the free tier. gpt-oss:20b-cloud is confirmed free-tier
# accessible; check ollama.com/upgrade for what your account actually has.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b-cloud

# Any sentence-transformers-compatible model name. bge-small is small/fast and
# runs fully offline (no API key) — swap for a larger model (e.g. bge-large,
# or Voyage AI's hosted API) if retrieval quality matters more than latency/cost.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Minimum cosine similarity for a retrieved chunk to count as relevant — see
# app/config.py for why this exists. Tune once you have a real document corpus;
# 0.35 was picked empirically against a near-empty test collection, not tuned
# data, so treat it as a starting point, not a validated default.
RETRIEVAL_SCORE_THRESHOLD=0.35
